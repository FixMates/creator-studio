rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function creatorIsPublished(uid) {
      return exists(/databases/$(database)/documents/creatorProfiles/$(uid))
        && get(/databases/$(database)/documents/creatorProfiles/$(uid)).data.published == true;
    }

    // Public directory content is curated by trusted admins in the Firebase Console.
    // Visitors can read showcase cards; client-side writes are intentionally blocked.
    match /showcaseStores/{storeId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow get, create, update: if isOwner(uid);
      allow list, delete: if false;
    }

    match /creatorProfiles/{uid} {
      allow get: if isOwner(uid) || resource.data.published == true;
      allow list: if resource.data.published == true;
      allow create: if isOwner(uid) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow list, update, delete: if false;
    }

    match /products/{productId} {
      allow get: if (signedIn() && !exists(/databases/$(database)/documents/products/$(productId)))
        || isOwner(resource.data.creatorId)
        || (resource.data.active == true && creatorIsPublished(resource.data.creatorId));
      allow list: if isOwner(resource.data.creatorId)
        || (resource.data.active == true && creatorIsPublished(resource.data.creatorId));
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if isOwner(resource.data.creatorId)
        && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isOwner(resource.data.creatorId);
    }

    match /analyticsEvents/{eventId} {
      // Public storefronts can emit bounded, non-PII events. Only the owning
      // creator can read their event stream; events cannot be edited or deleted.
      allow create: if request.resource.data.keys().hasOnly([
          "type", "creatorId", "username", "productId", "source", "referrerHost", "path", "createdAt"
        ])
        && request.resource.data.creatorId is string
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 100
        && request.resource.data.referrerHost is string
        && request.resource.data.referrerHost.size() <= 120
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 200
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.type == "store_view"
            && creatorIsPublished(request.resource.data.creatorId)
            && !("productId" in request.resource.data))
          ||
          (request.resource.data.type == "product_click"
            && request.resource.data.productId is string
            && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
            && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.creatorId == request.resource.data.creatorId
            && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.active == true
            && creatorIsPublished(request.resource.data.creatorId))
        );
      allow get, list: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow update, delete: if false;
    }


    match /creatorLeads/{leadId} {
      allow get, list: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 120
        && request.resource.data.status in ["new", "contacted", "follow_up", "converted", "not_interested"];
      allow update: if signedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.status in ["new", "contacted", "follow_up", "converted", "not_interested"];
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    match /collections/{collectionId} {
      allow get: if (signedIn() && !exists(/databases/$(database)/documents/collections/$(collectionId)))
        || isOwner(resource.data.creatorId)
        || creatorIsPublished(resource.data.creatorId);
      allow list: if isOwner(resource.data.creatorId)
        || creatorIsPublished(resource.data.creatorId);
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if isOwner(resource.data.creatorId)
        && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isOwner(resource.data.creatorId);
    }
  }
}
